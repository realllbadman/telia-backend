# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars-PLEASE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# SQLite (default for development)
DATABASE_URL=sqlite:///./telia.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://user:password@localhost/dbname

# Application
APP_NAME=Glotelho API
APP_VERSION=1.0.0
# Magento Configuration (REQUIRED)
# Get these values from your Magento store:
# - Base URL: Your Magento store's admin URL
# - Access Token: From System > Extensions > Integrations
MAGENTO_BASE_URL=https://your-magento-store.com
MAGENTO_ACCESS_TOKEN=your-magento-api-token
# AssemblyAI Speech-to-Text (for /chat/recommend/audio)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ASSEMBLYAI_SPEECH_MODELS=universal-2
ASSEMBLYAI_POLL_INTERVAL_SECONDS=2.0
ASSEMBLYAI_POLL_TIMEOUT_SECONDS=120
